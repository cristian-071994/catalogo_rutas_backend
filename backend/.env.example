# ============================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO
# ============================================
# Copiar este archivo como .env y configurar con valores reales

# Clave secreta para firmar tokens JWT (generar con: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=tu-clave-secreta-aqui

# Algoritmo de encriptación JWT
ALGORITHM=HS256

# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base de datos
DATABASE_URL=sqlite:///./catalogo_rutas.db
